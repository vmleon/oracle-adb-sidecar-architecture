deploy/terraform/**/terraform.tfstate.backup
deploy/terraform/**/.terraform.tfstate.lock.info
deploy/terraform/**/tfplan
deploy/terraform/**/crash.log
deploy/terraform/**/crash.*.log
deploy/terraform/**/generated/
deploy/terraform/**/*.zip

# Liquibase rendered configs
database/liquibase/**/liquibase.properties
database/wallet/

# Wallets / PKI material — never commit keys or certs
*.p12
*.jks
*.sso
*.pem
*.key
ewallet.*
cwallet.*
wallet/

