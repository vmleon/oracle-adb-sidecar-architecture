#!/bin/bash
set -e

touch /home/opc/bootstrap.lock

wait_for_dns() {
  local host="yum.${region_name}.oci.oraclecloud.com"
  local -i tries=0 max=150
  until getent ahostsv4 "$host" >/dev/null 2>&1; do
    tries=$((tries+1))
    if [ $tries -ge $max ]; then
      echo "FATAL: DNS for $host not ready after $((max*2))s" >&2
      exit 1
    fi
    sleep 2
  done
  echo "DNS ready after $tries attempt(s): $host"
}
wait_for_dns

wait_for_rpm_lock() {
  local -i tries=0 max=60
  while fuser /var/lib/rpm/.rpm.lock /var/lib/dnf/lock >/dev/null 2>&1; do
    tries=$((tries+1))
    if [ $tries -ge $max ]; then
      echo "FATAL: rpm/dnf lock busy after $((max*5))s" >&2
      exit 1
    fi
    sleep 5
  done
}
wait_for_rpm_lock

# A private instance reaches the yum mirrors through the NAT gateway, and in
# the first seconds of its life that path is not always up: dnf then fails
# with "Curl error (7): Couldn't connect to server". Under `set -e` a single
# blip kills the whole tier before Ansible ever runs, which is unrecoverable
# without a rebuild. Retry with linear backoff so a transient mirror or
# routing hiccup costs seconds instead of the instance.
dnf_retry() {
  local -i tries=0 max=10
  until dnf "$@"; do
    tries=$((tries+1))
    if [ $tries -ge $max ]; then
      echo "FATAL: dnf $* failed after $max attempts" >&2
      return 1
    fi
    echo "dnf $* failed (attempt $tries/$max); retrying in $((tries*10))s..." >&2
    sleep $((tries*10))
  done
}

dnf_retry upgrade -y
dnf_retry install oracle-epel-release-el9 -y
dnf_retry install ansible-core -y

# Ansible front artifact
curl -4 --fail -sS "${ansible_frontend_par_full_path}" -o /home/opc/ansible_frontend.zip
mkdir -p /home/opc/ansible_frontend
unzip /home/opc/ansible_frontend.zip -d /home/opc/ansible_frontend && rm -f /home/opc/ansible_frontend.zip

# Frontend dist artifact
mkdir -p /home/opc/ansible_frontend/roles/webstack/files
curl -4 --fail -sS "${frontend_par_full_path}" -o /home/opc/ansible_frontend/roles/webstack/files/web.zip
chown -R opc:opc /home/opc/ansible_frontend

cat <<EOT >> /home/opc/ansible_params.json
{
  "project_name": "${project_name}",
  "region_name": "${region_name}",
  "backend_private_ip": "${backend_private_ip}"
}
EOT
chown opc:opc /home/opc/ansible_params.json
chmod 600 /home/opc/ansible_params.json

cat <<EOT >> /home/opc/frontend.ini
[frontend]
localhost ansible_connection=local ansible_user=root

[frontend:vars]
ansible_python_interpreter="/usr/bin/python3"
EOT
chown opc:opc /home/opc/frontend.ini

touch /home/opc/ansible-playbook.log
chown opc:opc /home/opc/ansible-playbook.log

ANSIBLE_PYTHON_INTERPRETER="/usr/bin/python3" \
    ansible-galaxy collection install ansible.posix | tee -a /home/opc/ansible-playbook.log

ANSIBLE_PYTHON_INTERPRETER="/usr/bin/python3" ansible-playbook \
    -i /home/opc/frontend.ini \
    --extra-vars "@/home/opc/ansible_params.json" \
    /home/opc/ansible_frontend/server.yaml | tee -a /home/opc/ansible-playbook.log

rm /home/opc/bootstrap.lock
